<%- include("../partials/header", { title }) %>

    <section class="page-header">
        <div class="page-title-group">
            <h1>Create Booking</h1>
            <p>Select a tour package and enter passenger information.</p>
        </div>

        <a href="/bookings" class="btn btn-secondary">
            Back to Bookings
        </a>
    </section>

    <section class="card form-card">
        <div class="card-body">

            <% if (error) { %>
                <div class="alert alert-danger">
                    <%= error %>
                </div>
                <% } %>

                    <% if (tourPackages.length===0) { %>

                        <div class="empty-state">
                            No active tour packages with available seats were found.
                        </div>

                        <div class="button-row">
                            <a href="/tour-packages/create" class="btn btn-primary">
                                Add Tour Package
                            </a>

                            <a href="/bookings" class="btn btn-secondary">
                                Back to Bookings
                            </a>
                        </div>

                        <% } else { %>

                            <form action="/bookings/create" method="POST">

                                <div class="form-grid">

                                    <div class="form-group full-width">
                                        <label for="tourPackage" class="form-label">
                                            Select Tour Package
                                        </label>

                                        <select id="tourPackage" name="tourPackage" class="form-control" required>
                                            <option value="">
                                                Select a package
                                            </option>

                                            <% tourPackages.forEach((tourPackage)=> { %>

                                                <option value="<%= tourPackage._id %>"
                                                    data-title="<%= tourPackage.title %>"
                                                    data-operator="<%= tourPackage.operatorName || " Not assigned" %>"
                                                    data-route="<%= tourPackage.fromLocation %> to <%=
                                                            tourPackage.toLocation %>"
                                                            data-date="<%= new
                                                                Date(tourPackage.journeyDate).toLocaleDateString("en-GB")
                                                                %>"
                                                                data-departure="<%= tourPackage.departureTime %>"
                                                                    data-arrival="<%= tourPackage.arrivalTime
                                                                        || "Not specified" %>"
                                                                        data-fare="<%=
                                                                            Number(tourPackage.fare).toFixed(2) %>"
                                                                            data-seats="<%= tourPackage.availableSeats
                                                                                %>"
                                                                                <%= String(formData.tourPackage || ""
                                                                                    )===String(tourPackage._id)
                                                                                    ? "selected" : "" %>
                                                                                    >
                                                                                    <%= tourPackage.packageCode %> -
                                                                                        <%= tourPackage.title %> -
                                                                                            <%= tourPackage.operatorName
                                                                                                || "Not assigned" %>
                                                </option>

                                                <% }) %>
                                        </select>
                                    </div>

                                    <div class="form-group full-width">
                                        <div class="dashboard-grid">

                                            <div class="dashboard-card">
                                                <div class="dashboard-label">
                                                    Package
                                                </div>

                                                <div class="dashboard-value" id="summaryTitle">
                                                    Not selected
                                                </div>
                                            </div>

                                            <div class="dashboard-card">
                                                <div class="dashboard-label">
                                                    Operator
                                                </div>

                                                <div class="dashboard-value" id="summaryOperator">
                                                    Not selected
                                                </div>
                                            </div>

                                            <div class="dashboard-card">
                                                <div class="dashboard-label">
                                                    Fare
                                                </div>

                                                <div class="dashboard-value" id="summaryFare">
                                                    BDT 0.00
                                                </div>
                                            </div>

                                            <div class="dashboard-card">
                                                <div class="dashboard-label">
                                                    Available Seats
                                                </div>

                                                <div class="dashboard-value" id="summarySeats">
                                                    0
                                                </div>
                                            </div>

                                        </div>
                                    </div>

                                    <div class="form-group full-width">
                                        <label class="form-label">
                                            Selected Package Details
                                        </label>

                                        <div class="image-preview-box">
                                            <div class="image-preview-placeholder">
                                                <strong>Route:</strong>
                                                <span id="summaryRoute">
                                                    Not selected
                                                </span>

                                                <br>

                                                <strong>Journey Date:</strong>
                                                <span id="summaryDate">
                                                    Not selected
                                                </span>

                                                <br>

                                                <strong>Departure:</strong>
                                                <span id="summaryDeparture">
                                                    Not selected
                                                </span>

                                                <br>

                                                <strong>Arrival:</strong>
                                                <span id="summaryArrival">
                                                    Not selected
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label for="passengerName" class="form-label">
                                            Passenger Name
                                        </label>

                                        <input type="text" id="passengerName" name="passengerName" class="form-control"
                                            value="<%= formData.passengerName || "" %>"
                                            placeholder="Enter passenger name" required>
                                    </div>

                                    <div class="form-group">
                                        <label for="phoneNumber" class="form-label">
                                            Phone Number
                                        </label>

                                        <input type="tel" id="phoneNumber" name="phoneNumber" class="form-control"
                                            value="<%= formData.phoneNumber || "" %>" placeholder="01XXXXXXXXX"
                                            required>
                                    </div>

                                    <div class="form-group">
                                        <label for="seatNumber" class="form-label">
                                            Seat Number
                                        </label>

                                        <input type="text" id="seatNumber" name="seatNumber" class="form-control"
                                            value="<%= formData.seatNumber || "" %>" placeholder="A1" required>

                                        <span class="form-help">
                                            Enter a unique seat number for the selected package.
                                        </span>
                                    </div>

                                    <div class="form-group">
                                        <label for="paymentStatus" class="form-label">
                                            Payment Status
                                        </label>

                                        <select id="paymentStatus" name="paymentStatus" class="form-control" required>
                                            <option value="Pending" <%=formData.paymentStatus==="Pending" ||
                                                !formData.paymentStatus ? "selected" : "" %>
                                                >
                                                Pending
                                            </option>

                                            <option value="Paid" <%=formData.paymentStatus==="Paid" ? "selected" : "" %>
                                                >
                                                Paid
                                            </option>

                                            <option value="Refunded" <%=formData.paymentStatus==="Refunded" ? "selected"
                                                : "" %>
                                                >
                                                Refunded
                                            </option>
                                        </select>
                                    </div>

                                </div>

                                <div class="button-row">
                                    <button type="submit" class="btn btn-primary">
                                        Confirm Booking
                                    </button>

                                    <a href="/bookings" class="btn btn-secondary">
                                        Cancel
                                    </a>
                                </div>

                            </form>

                            <% } %>

        </div>
    </section>

    <script>
        const tourPackageSelect =
            document.getElementById("tourPackage");

        const summaryTitle =
            document.getElementById("summaryTitle");

        const summaryOperator =
            document.getElementById("summaryOperator");

        const summaryRoute =
            document.getElementById("summaryRoute");

        const summaryDate =
            document.getElementById("summaryDate");

        const summaryDeparture =
            document.getElementById("summaryDeparture");

        const summaryArrival =
            document.getElementById("summaryArrival");

        const summaryFare =
            document.getElementById("summaryFare");

        const summarySeats =
            document.getElementById("summarySeats");

        const updatePackageSummary = () => {
            const selectedOption =
                tourPackageSelect.options[
                tourPackageSelect.selectedIndex
                ];

            if (!selectedOption || !selectedOption.value) {
                summaryTitle.textContent = "Not selected";
                summaryOperator.textContent = "Not selected";
                summaryRoute.textContent = "Not selected";
                summaryDate.textContent = "Not selected";
                summaryDeparture.textContent = "Not selected";
                summaryArrival.textContent = "Not selected";
                summaryFare.textContent = "BDT 0.00";
                summarySeats.textContent = "0";
                return;
            }

            summaryTitle.textContent =
                selectedOption.dataset.title;

            summaryOperator.textContent =
                selectedOption.dataset.operator;

            summaryRoute.textContent =
                selectedOption.dataset.route;

            summaryDate.textContent =
                selectedOption.dataset.date;

            summaryDeparture.textContent =
                selectedOption.dataset.departure;

            summaryArrival.textContent =
                selectedOption.dataset.arrival;

            summaryFare.textContent =
                `BDT ${selectedOption.dataset.fare}`;

            summarySeats.textContent =
                selectedOption.dataset.seats;
        };

        tourPackageSelect.addEventListener(
            "change",
            updatePackageSummary
        );

        updatePackageSummary();
    </script>

    <%- include("../partials/footer") %>