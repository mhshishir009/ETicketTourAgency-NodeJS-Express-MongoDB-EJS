<%- include("../partials/header", { title }) %>

    <section class="page-header no-print">
        <div class="page-title-group">
            <h1>Passenger E-Ticket</h1>
            <p>View and print the confirmed passenger ticket.</p>
        </div>

        <div class="action-group">
            <a href="/bookings" class="btn btn-secondary">
                Back to Bookings
            </a>

            <button type="button" class="btn btn-primary" onclick="window.print()">
                Print Ticket
            </button>
        </div>
    </section>

    <section class="ticket-wrapper">

        <div class="ticket-card">

            <div class="ticket-header">
                <div>
                    <div class="ticket-brand">TripQuest</div>
                    <div class="ticket-subtitle">
                        E-Ticketing Tour Agency
                    </div>
                </div>

                <div class="ticket-number-group">
                    <span>Ticket Number</span>
                    <strong>
                        <%= booking.ticketNumber %>
                    </strong>
                </div>
            </div>

            <div class="ticket-status-row">
                <span class="status-badge status-<%= booking.bookingStatus.toLowerCase() %>">
                    <%= booking.bookingStatus %>
                </span>

                <span class="status-badge status-<%= booking.paymentStatus.toLowerCase() %>">
                    Payment: <%= booking.paymentStatus %>
                </span>
            </div>

            <div class="ticket-section">
                <h2>Passenger Information</h2>

                <div class="ticket-grid">
                    <div class="ticket-item">
                        <span>Passenger Name</span>
                        <strong>
                            <%= booking.passengerName %>
                        </strong>
                    </div>

                    <div class="ticket-item">
                        <span>Phone Number</span>
                        <strong>
                            <%= booking.phoneNumber %>
                        </strong>
                    </div>

                    <div class="ticket-item">
                        <span>Seat Number</span>
                        <strong>
                            <%= booking.seatNumber %>
                        </strong>
                    </div>

                    <div class="ticket-item">
                        <span>Ticket Fare</span>
                        <strong>
                            BDT <%= Number(booking.fare).toFixed(2) %>
                        </strong>
                    </div>
                </div>
            </div>

            <% if (booking.tourPackage) { %>

                <div class="ticket-section">
                    <h2>Journey Information</h2>

                    <div class="ticket-route">
                        <div class="ticket-location">
                            <span>From</span>
                            <strong>
                                <%= booking.tourPackage.fromLocation %>
                            </strong>
                        </div>

                        <div class="ticket-route-arrow">
                            →
                        </div>

                        <div class="ticket-location">
                            <span>To</span>
                            <strong>
                                <%= booking.tourPackage.toLocation %>
                            </strong>
                        </div>
                    </div>

                    <div class="ticket-grid">
                        <div class="ticket-item">
                            <span>Package Code</span>
                            <strong>
                                <%= booking.tourPackage.packageCode %>
                            </strong>
                        </div>

                        <div class="ticket-item">
                            <span>Package Title</span>
                            <strong>
                                <%= booking.tourPackage.title %>
                            </strong>
                        </div>

                        <div class="ticket-item">
                            <span>Operator Name</span>
                            <strong>
                                <%= booking.tourPackage.operatorName || "Not assigned" %>
                            </strong>
                        </div>

                        <div class="ticket-item">
                            <span>Transport Type</span>
                            <strong>
                                <%= booking.tourPackage.transportType %>
                            </strong>
                        </div>

                        <div class="ticket-item">
                            <span>Journey Date</span>
                            <strong>
                                <%= new Date(booking.tourPackage.journeyDate).toLocaleDateString("en-GB") %>
                            </strong>
                        </div>

                        <div class="ticket-item">
                            <span>Departure Time</span>
                            <strong>
                                <%= booking.tourPackage.departureTime %>
                            </strong>
                        </div>

                        <div class="ticket-item">
                            <span>Arrival Time</span>
                            <strong>
                                <%= booking.tourPackage.arrivalTime || "Not specified" %>
                            </strong>
                        </div>

                        <div class="ticket-item">
                            <span>Booking Date</span>
                            <strong>
                                <%= new Date(booking.bookedAt).toLocaleString("en-GB") %>
                            </strong>
                        </div>
                    </div>
                </div>

                <% } else { %>

                    <div class="alert alert-danger">
                        The related tour package is no longer available.
                    </div>

                    <% } %>

                        <div class="ticket-footer">
                            <p>
                                Please carry this ticket during your journey.
                            </p>

                            <p>
                                Thank you for choosing TripQuest.
                            </p>
                        </div>

        </div>

    </section>

    <style>
        .ticket-wrapper {
            display: flex;
            justify-content: center;
        }

        .ticket-card {
            width: 100%;
            max-width: 950px;
            padding: 32px;
            border: 1px solid rgba(148, 163, 184, 0.22);
            border-radius: 20px;
            background: linear-gradient(145deg,
                    rgba(15, 23, 42, 0.96),
                    rgba(15, 46, 60, 0.92));
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
        }

        .ticket-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 24px;
            padding-bottom: 24px;
            border-bottom: 1px dashed rgba(148, 163, 184, 0.35);
        }

        .ticket-brand {
            font-size: 32px;
            font-weight: 800;
            letter-spacing: 1px;
        }

        .ticket-subtitle {
            margin-top: 6px;
            color: #94a3b8;
        }

        .ticket-number-group {
            text-align: right;
        }

        .ticket-number-group span {
            display: block;
            margin-bottom: 6px;
            color: #94a3b8;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .ticket-number-group strong {
            color: #22d3ee;
            font-size: 20px;
        }

        .ticket-status-row {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            padding: 22px 0;
        }

        .ticket-section {
            padding: 24px 0;
            border-top: 1px solid rgba(148, 163, 184, 0.16);
        }

        .ticket-section h2 {
            margin: 0 0 20px;
            font-size: 20px;
        }

        .ticket-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }

        .ticket-item {
            padding: 16px;
            border: 1px solid rgba(148, 163, 184, 0.16);
            border-radius: 12px;
            background: rgba(15, 23, 42, 0.45);
        }

        .ticket-item span,
        .ticket-location span {
            display: block;
            margin-bottom: 6px;
            color: #94a3b8;
            font-size: 13px;
        }

        .ticket-item strong,
        .ticket-location strong {
            font-size: 16px;
        }

        .ticket-route {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            gap: 20px;
            margin-bottom: 22px;
            padding: 22px;
            border-radius: 16px;
            background: rgba(8, 145, 178, 0.12);
        }

        .ticket-location:last-child {
            text-align: right;
        }

        .ticket-route-arrow {
            color: #22d3ee;
            font-size: 32px;
            font-weight: 700;
        }

        .ticket-footer {
            padding-top: 24px;
            border-top: 1px dashed rgba(148, 163, 184, 0.35);
            text-align: center;
            color: #94a3b8;
        }

        .ticket-footer p {
            margin: 5px 0;
        }

        @media (max-width: 700px) {
            .ticket-card {
                padding: 20px;
            }

            .ticket-header {
                flex-direction: column;
            }

            .ticket-number-group {
                text-align: left;
            }

            .ticket-grid {
                grid-template-columns: 1fr;
            }

            .ticket-route {
                grid-template-columns: 1fr;
            }

            .ticket-route-arrow {
                transform: rotate(90deg);
                text-align: center;
            }

            .ticket-location:last-child {
                text-align: left;
            }
        }

        @media print {
            body {
                background: #ffffff;
                color: #000000;
                padding: 0;
            }

            .site-navbar,
            .site-footer,
            .no-print {
                display: none;
            }

            .page-main {
                width: 100%;
                max-width: none;
                padding: 0;
            }

            .ticket-card {
                max-width: none;
                padding: 20px;
                border: 1px solid #000000;
                border-radius: 0;
                background: #ffffff;
                color: #000000;
                box-shadow: none;
            }

            .ticket-number-group strong,
            .ticket-route-arrow {
                color: #000000;
            }

            .ticket-subtitle,
            .ticket-number-group span,
            .ticket-item span,
            .ticket-location span,
            .ticket-footer {
                color: #333333;
            }

            .ticket-item {
                border: 1px solid #cccccc;
                background: #ffffff;
            }

            .ticket-route {
                border: 1px solid #cccccc;
                background: #ffffff;
            }
        }
    </style>

    <%- include("../partials/footer") %>